NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API. Leave empty to allow none.
CORS_ORIGINS=http://localhost:5173

# Used by docker compose for the database container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blog
POSTGRES_PORT=5433

# Used when running the API on your host (npm run dev). Docker compose overrides it.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/blog

# Secret for signing access tokens, at least 32 characters. Required. Generate one with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=

# Set to false so that only admins can create, update, and delete blogs.
BLOG_CUSTOMER_WRITES_ENABLED=true

# Disposable database used by npm test, which starts it automatically.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/blog_test
