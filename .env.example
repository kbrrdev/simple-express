# Staging uses NODE_ENV=production, so that it behaves like production.
NODE_ENV=development
# development, staging, or production. Added to logs, and turns Swagger off in production.
APP_ENV=development
PORT=3000

# debug, info, warn, error, or silent.
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API. Leave empty to allow none.
CORS_ORIGINS=http://localhost:5173

# Used by docker compose for the database container. The password is required, so
# use a random value with URL-safe characters. Generate one with:
# node -p "require('crypto').randomBytes(24).toString('hex')"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=blog
POSTGRES_PORT=5433

# The API connects as this limited role, which can read and write rows only.
# Use URL-safe characters in the password. Required. Generate one with:
# node -p "require('crypto').randomBytes(24).toString('hex')"
APP_DB_USER=app
APP_DB_PASSWORD=

# Used when running on your host. Docker compose builds its own from the values above.
# npm run db:migrate creates the DATABASE_URL role, so run it first.
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5433/blog
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/blog

# Number of proxies in front of the API. Leave at 0 if there are none. Setting it too
# high lets clients fake their IP address and dodge rate limits.
TRUST_PROXY_HOPS=0

# Secret for signing access tokens, at least 32 characters. Required. Generate one with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=

# Public address of this API, used to build the URLs of uploaded files.
PUBLIC_BASE_URL=http://localhost:3000

# Page that password reset emails link to. The token is added as #token=..., which
# browsers never send to a server, so the page reads it with JavaScript.
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# Email. Development uses Mailpit, with its inbox at http://localhost:8025, so nothing is
# really delivered. Leave SMTP_HOST empty to turn email off. Real servers need a username and
# password, and these are sent over an encrypted connection.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Your Store <orders@your-store.com>"

# Tax added to orders. Set the rate to 0 to charge none. Decimals such as 7.5 are allowed.
TAX_RATE_PERCENT=12
# true means prices already contain tax. false adds it on top at checkout.
PRICES_INCLUDE_TAX=true

# Flat shipping fee in cents, so 10000 is 100.00.
SHIPPING_FEE_CENTS=10000
# Orders at least this much after discounts ship free, so 150000 is 1,500.00. Leave empty
# to always charge shipping.
FREE_SHIPPING_MIN_CENTS=

# Hours an unpaid order holds its stock before it is cancelled.
PAYMENT_WINDOW_HOURS=24

# Unpaid orders one customer or guest email can have open, so nobody can hold all the stock.
MAX_OPEN_UNPAID_ORDERS=5

# Uploaded files are saved to disk, in a Docker volume when running in Docker.
# To use S3 instead, set the bucket, region, and both keys. The API will not start
# with only some of them. The bucket must allow public reads.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services. S3_PUBLIC_URL is required with S3_ENDPOINT, and
# is optional on AWS, for example to serve files through a CDN.
S3_ENDPOINT=
S3_PUBLIC_URL=

# Disposable database used by npm test, which starts it automatically.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/blog_test
